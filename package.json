{
  "name": "dsh-ui-zoom",
  "version": "0.2.0",
  "description": "Ctrl+wheel native page zoom for DeepSeek Harness (60–180%, remembered), plus a bottom-right Settings entry.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/smoke.mjs",
    "check": "node --check lib/client.js && node --check lib/index.js && node scripts/smoke.mjs"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "zoom",
    "ui-scale",
    "accessibility",
    "settings"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.0-rc.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dshTarget": "0.2.0-rc.2"
}
