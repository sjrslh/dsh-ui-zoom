{
  "name": "dsh-ui-zoom",
  "version": "0.4.2",
  "description": "Ctrl+wheel page zoom for DeepSeek Harness (60–180%, remembered) with a layout-consistent metric shim, popovers that stay in place, a root-scroll lock and a bottom-right Settings entry.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "scripts",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/smoke.mjs",
    "check": "node --check lib/client.js && node --check lib/index.js && node scripts/smoke.mjs && node scripts/zoom.test.mjs"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "zoom",
    "ui-scale",
    "accessibility",
    "settings"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.0-rc.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dshTarget": "0.2.0-rc.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sjrslh/dsh-ui-zoom.git"
  },
  "homepage": "https://github.com/sjrslh/dsh-ui-zoom#readme",
  "bugs": {
    "url": "https://github.com/sjrslh/dsh-ui-zoom/issues"
  }
}
